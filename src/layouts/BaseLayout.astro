---
// Story 1-2. The one layout every page uses.
//
// The `robots` meta below is env-driven and MUST STAY THAT WAY. A hardcoded
// `noindex` here de-indexes production, which is worse than the duplicate it
// would prevent (spec § 1.2). The polarity comes from src/lib/site-env.mjs and
// is asserted in both directions by scripts/check-indexing-polarity.mjs.
import { INDEXABLE, SITE_URL, GSC_TOKEN } from '../lib/site-env.mjs';
import { medicalBusiness } from '../lib/schema.mjs';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';

interface Props {
  title: string;
  description: string;
  /** Override the OG image path. Root-relative. */
  image?: string;
  /**
   * Visible "last updated" date. REQUIRED, and deliberately has no default.
   *
   * AG-3 F5. This used to default to `new Date()`, which meant a static site
   * rebuilt on every push re-stamped every untouched page as "updated today",
   * forever. That is not a freshness signal, it is noise, and on a health site
   * it is a small untruth on every page.
   *
   * privacy.astro had already worked this out and opted out by hand, with the
   * right reasoning written down: a policy's "last updated" means the date the
   * POLICY changed. That reasoning is not privacy-specific — it is just as true
   * of a services page. So every page now states its date deliberately, and a
   * page nobody has touched keeps its real one.
   *
   * A visible date is one of the few things the controlled evidence actually
   * supports (reconciliation § 2), which is exactly why it has to be true.
   */
  updated: Date;
}

const { title, description, image = '/og-default.png', updated } = Astro.props;

// Canonical is SELF-referential, including on staging. Pointing staging's
// canonical at production would be a lie about which document this is; the
// noindex is what keeps staging out of the index.
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogImage = new URL(image, SITE_URL).href;

// BOTH forms are pinned to Australia/Sydney, deliberately.
//
// toISOString() is UTC. The build runs on a UTC CI runner, and Sydney is
// UTC+10/+11, so any build after 2pm Sydney lands on the PREVIOUS UTC date —
// the machine-readable datetime and the visible text would disagree, and an
// Australian reader would be shown yesterday. Caught locally on the first
// build: datetime="2026-07-30" next to "31 July 2026".
const SYDNEY = 'Australia/Sydney';
// en-CA gives YYYY-MM-DD, which is the format <time datetime> wants.
const updatedISO = updated.toLocaleDateString('en-CA', { timeZone: SYDNEY });
const updatedHuman = updated.toLocaleDateString('en-AU', {
  timeZone: SYDNEY,
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* Env-driven. See the comment at the top of this file before touching it. */}
    <meta name="robots" content={INDEXABLE ? 'index, follow' : 'noindex, nofollow'} />

    {/* Search Console ownership. Must survive the migration. */}
    <meta name="google-site-verification" content={GSC_TOKEN} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_AU" />
    <meta name="twitter:card" content="summary_large_image" />

    {/* Story 1-5. The site-wide MedicalBusiness is emitted on EVERY page
        automatically rather than per-page, because the profile corroboration it
        exists for has to hold wherever Google lands. Pages add their own
        Physician / Service / FAQPage nodes through the slot below.
        AHPRA s133: no Review or AggregateRating node, ever. */}
    <script
      type="application/ld+json"
      set:html={JSON.stringify(medicalBusiness(SITE_URL))}
    />
    <slot name="head-jsonld" />

    <slot name="head" />

    {/* Story 1-8. Cookieless, so no consent banner. Emits nothing at all when
        no token is configured, and the privacy policy reads the same flag so
        the two can never disagree about whether analytics are running. */}
    <Analytics />

    {/* LN-2 F4. The design tokens, and the ONLY place a raw colour is written.
        Global rather than scoped, because custom properties inherit: every
        component's own scoped <style> reads these with var() instead of
        repeating the literal.

        The finding was the RECURRENCE, not the values — #5b6560 appeared five
        times across four files, #e4e1da three times, and a hand-copied hex that
        happens to be correct today is the argument FOR the token, not evidence
        the risk is retired. Story 1-6 adds eight pages; without this, it adds
        eight more chances to typo a colour that no check would catch.

        --ml-ink and --ml-deep are two near-identical dark greens. Argus read
        them as probably meant to be one value and is probably right, but
        collapsing them is a design decision that belongs with Keegan's open
        accent call (LN-2 F1), not a refactor. Kept distinct and named so the
        question is visible rather than buried in two hex literals. */}
    <style is:global>
      :root {
        --ml-paper: #fdfbf8; /* page background */
        --ml-ink: #1b211f; /* body text */
        --ml-muted: #5b6560; /* secondary text, labels */
        --ml-rule: #e4e1da; /* hairlines and table borders */
        --ml-shade: #f1efea; /* table header fill */
        --ml-code: #e9e6df; /* inline code fill */
        --ml-deep: #1f3330; /* button hover, focus outline */
        --ml-accent: #ff3502; /* the booking call to action — LN-2 F1, Keegan's open call */

        /* Channel forms, for the few places that need a fade to transparent.
           A gradient fading to the CSS keyword `transparent` is a fade to
           transparent BLACK, which greys the middle of the ramp. These exist so
           the fade matches its own colour, and so the pair cannot drift apart
           from the hex above by hand. */
        --ml-paper-rgb: 253, 251, 248;
        --ml-ink-rgb: 27, 33, 31;
      }
    </style>

    <style>
      body {
        text-wrap: pretty;
        font-family: system-ui, -apple-system, sans-serif;
        max-width: 44rem;
        margin: 0 auto;
        padding: 2rem 1.5rem 4rem;
        line-height: 1.6;
        color: var(--ml-ink);
        background: var(--ml-paper);
      }
      h1,
      h2,
      h3 {
        text-wrap: balance;
      }
      /* Lens LN-3. Story 1-10 added 8 images across 6 pages, each with its own
         class and its own width rule, and there was no shared floor. The About
         portrait capped at `max-width: 20rem` = 320px, which is WIDER than the
         272px content column at a 320px viewport, so it pushed the whole page
         sideways — the only horizontal overflow in 56 page/width combinations.
         Fixing `.portrait` alone would leave the other seven one careless value
         away from the same bug, and 1-10 is still adding images. This is the
         floor that makes the class impossible. It only ever constrains an image
         that would otherwise exceed its container, so nothing else moves. */
      img {
        max-width: 100%;
        height: auto;
      }
      code {
        background: var(--ml-code);
        padding: 0.15em 0.4em;
        border-radius: 3px;
      }
      .site-updated {
        margin-top: 3rem;
        padding-top: 1rem;
        border-top: 1px solid var(--ml-rule);
        font-size: 0.875rem;
        color: var(--ml-muted);
      }
    </style>
  </head>

  <body>
    <Nav current={Astro.url.pathname} />

    {/* The skip link in Nav targets this id. A landmark <main> is also how a
        screen-reader user jumps past the header on every page. */}
    <main id="main">
      <slot />
    </main>

    {/* Visible last-updated date. Concrete on-page facts are what the
        controlled evidence actually supports (reconciliation § 2). */}
    <p class="site-updated">
      Last updated <time datetime={updatedISO}>{updatedHuman}</time>
    </p>

    {/* Story 1-5. Visible NAP on EVERY page — the corroboration Google looked
        for and did not find when it rejected Keegan's profile edits. */}
    <Footer />

    <slot name="body-end" />
  </body>
</html>
