---
// Story 1-2. The one layout every page uses.
//
// The `robots` meta below is env-driven and MUST STAY THAT WAY. A hardcoded
// `noindex` here de-indexes production, which is worse than the duplicate it
// would prevent (spec § 1.2). The polarity comes from src/lib/site-env.mjs and
// is asserted in both directions by scripts/check-indexing-polarity.mjs.
import { INDEXABLE, SITE_URL, GSC_TOKEN } from '../lib/site-env.mjs';
import { medicalBusiness } from '../lib/schema.mjs';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';

interface Props {
  title: string;
  description: string;
  /** Override the OG image path. Root-relative. */
  image?: string;
  /**
   * Visible "last updated" date. REQUIRED, and deliberately has no default.
   *
   * AG-3 F5. This used to default to `new Date()`, which meant a static site
   * rebuilt on every push re-stamped every untouched page as "updated today",
   * forever. That is not a freshness signal, it is noise, and on a health site
   * it is a small untruth on every page.
   *
   * privacy.astro had already worked this out and opted out by hand, with the
   * right reasoning written down: a policy's "last updated" means the date the
   * POLICY changed. That reasoning is not privacy-specific — it is just as true
   * of a services page. So every page now states its date deliberately, and a
   * page nobody has touched keeps its real one.
   *
   * A visible date is one of the few things the controlled evidence actually
   * supports (reconciliation § 2), which is exactly why it has to be true.
   */
  updated: Date;
}

const { title, description, image = '/og-default.png', updated } = Astro.props;

// Canonical is SELF-referential, including on staging. Pointing staging's
// canonical at production would be a lie about which document this is; the
// noindex is what keeps staging out of the index.
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogImage = new URL(image, SITE_URL).href;

// BOTH forms are pinned to Australia/Sydney, deliberately.
//
// toISOString() is UTC. The build runs on a UTC CI runner, and Sydney is
// UTC+10/+11, so any build after 2pm Sydney lands on the PREVIOUS UTC date —
// the machine-readable datetime and the visible text would disagree, and an
// Australian reader would be shown yesterday. Caught locally on the first
// build: datetime="2026-07-30" next to "31 July 2026".
const SYDNEY = 'Australia/Sydney';
// en-CA gives YYYY-MM-DD, which is the format <time datetime> wants.
const updatedISO = updated.toLocaleDateString('en-CA', { timeZone: SYDNEY });
const updatedHuman = updated.toLocaleDateString('en-AU', {
  timeZone: SYDNEY,
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* Env-driven. See the comment at the top of this file before touching it. */}
    <meta name="robots" content={INDEXABLE ? 'index, follow' : 'noindex, nofollow'} />

    {/* Search Console ownership. Must survive the migration. */}
    <meta name="google-site-verification" content={GSC_TOKEN} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_AU" />
    <meta name="twitter:card" content="summary_large_image" />

    {/* Story 1-5. The site-wide MedicalBusiness is emitted on EVERY page
        automatically rather than per-page, because the profile corroboration it
        exists for has to hold wherever Google lands. Pages add their own
        Physician / Service / FAQPage nodes through the slot below.
        AHPRA s133: no Review or AggregateRating node, ever. */}
    <script
      type="application/ld+json"
      set:html={JSON.stringify(medicalBusiness(SITE_URL))}
    />
    <slot name="head-jsonld" />

    <slot name="head" />

    {/* Story 1-8. Cookieless, so no consent banner. Emits nothing at all when
        no token is configured, and the privacy policy reads the same flag so
        the two can never disagree about whether analytics are running. */}
    <Analytics />

    {/* LN-2 F4. The design tokens, and the ONLY place a raw colour is written.
        Global rather than scoped, because custom properties inherit: every
        component's own scoped <style> reads these with var() instead of
        repeating the literal.

        The finding was the RECURRENCE, not the values — #5b6560 appeared five
        times across four files, #e4e1da three times, and a hand-copied hex that
        happens to be correct today is the argument FOR the token, not evidence
        the risk is retired. Story 1-6 adds eight pages; without this, it adds
        eight more chances to typo a colour that no check would catch.

        ~~--ml-ink and --ml-deep are kept distinct pending Keegan's accent
        call~~ — RESOLVED (SM-11 (4)): Lens measured them at 1.226:1 apart and
        UD-21 closed without touching the accent, so they are now one value
        under two names. See --ml-deep below.

        ⚠️ EVERYTHING THAT MUST REACH PAGE CONTENT LIVES IN THIS `is:global`
        BLOCK, NOT THE SCOPED ONE UNDERNEATH, and the distinction is not
        cosmetic. Astro compiles a scoped rule to `.page-img[data-astro-cid-XXX]`
        where XXX is THIS layout's id. Page content arrives through <slot> and
        carries its OWN id, so a scoped rule here silently matches nothing in it.
        I put the shared image classes and the link colour in the scoped block
        first: the build was clean, the CSS was present, and 30 of 40
        page/width combinations overflowed because not one image rule applied.
        Only a browser found it. */}
    <style is:global>
      /* ═══ LN-6 / story 1-15. THE REAL BRAND PALETTE ═══
         Every value below is Keegan's documented brand, not the site's previous
         approximation of it. His words: "id prefer my main colours not the ones
         currently used by my site - i think those were the closest i could get
         manually when i hand made that site." So #ff3502 and the neutral
         paper/ink theme were a hand-eyeballed stand-in; this is the real thing.

         🔴 THE ONE RULE THAT GOVERNS ALL OF IT: ORANGE IS NEVER A TEXT COLOUR.
         --ml-accent on paper measures 3.22:1. That clears the 3.0 bar for large
         text and UI, and fails the 4.5 bar for body text. The brand spec's own
         derived #D64100 measures 4.41 on THIS paper — still under 4.5 — so
         there is no orange that works as body text on Keegan's warm ground.
         Deep green carries every word at 12.40:1 (AAA, enormous headroom);
         orange is fills, large headings, icons, focus rings and borders. That
         is also exactly how the brand deck uses it.
         Orange on sage is 2.11:1 — never put them together at all. */
      :root {
        --ml-paper: #fdfbf8; /* page ground — warm off-white, kept from before */
        --ml-ink: #2A3529; /* deep green. Body text and headings. 12.40 on paper */
        --ml-surface: #C7D1C1; /* sage. Calm section/card surface. ink on it = 8.12 */
        /* DERIVED, not picked: ink blended 16% toward paper. The binding
           constraint was sage, not paper — muted text can land on EITHER
           ground, so it has to clear 4.5 on both. 7.51 on paper, 4.92 on sage.
           The previous #5b6560 was a warm grey with no relationship to any
           brand value; this one is the same hue family as the ink. */
        --ml-muted: #4c554a; /* secondary text, labels */
        /* Hairlines and fills re-tinted into the sage family so they read as
           part of the palette rather than as leftover warm grey. */
        --ml-rule: #dfe4da; /* hairlines and table borders */
        --ml-shade: #ebede5; /* table header fill, soft bands */
        --ml-code: #e5e8df; /* inline code fill */
        /* LN-3 F9 / SM-11 (4). --ml-deep WAS #1f3330, a second dark green
           1.226:1 from --ml-ink — per-channel delta of at most 18/255, which is
           indistinguishable to the eye and, as Lens measured, they never appear
           side by side anyway. Two names for one colour is a drift trap: the
           next person to adjust one has no way to know the other exists.
           Collapsed to ONE value while KEEPING BOTH NAMES, so the semantic hook
           survives — if a genuinely distinct hover/focus colour is ever wanted,
           it changes here and nothing else moves. Safe to do now that UD-21
           closed without touching the accent. */
        --ml-deep: var(--ml-ink); /* button hover, focus outline */
        /* THE brand orange. Was #ff3502 — Keegan's own manual approximation
           from hand-building the WordPress site, never a brand value. This one
           is [VERIFIED] across three independent brand slides.
           ⚠️ UD-21 KNOCK-ON, AND IT SURVIVES: the booking button was settled as
           "keep the colour, make the label 19px/700" at 3.53:1 on the old
           orange. On the real #FF4D00 the same pair is 3.22:1 — still over the
           3.0 large-text bar, so the fix holds. But headroom fell from 0.53 to
           0.22, which makes 19px/700 a FLOOR, not a suggestion. Anything
           smaller or lighter puts that label back under the 4.5 body-text rule
           and it fails. There is a comment saying so on the button itself. */
        --ml-accent: #FF4D00; /* fills, large headings, icons, focus, borders — NEVER text */

        /* LN-3 F6 / SM-11 (1). THE ONE COLOUR ON THE SITE NOBODY HAD CHOSEN.
           SM-5 F6 was reported closed on the grounds that "link colour is
           inherited by the token layer". Footer links do inherit; BODY links
           never had a colour at all, so every one on all 8 pages rendered as
           browser-default #0000ee. It passed contrast, which is why it survived
           review — this is coherence, not accessibility.
           --ml-ink plus an underline is what the footer already does, and the
           underline is what carries the affordance once the colour stops
           shouting. */
        --ml-link: var(--ml-ink);

        /* Channel forms, for the few places that need a fade to transparent.
           A gradient fading to the CSS keyword `transparent` is a fade to
           transparent BLACK, which greys the middle of the ramp. These exist so
           the fade matches its own colour, and so the pair cannot drift apart
           from the hex above by hand. */
        --ml-paper-rgb: 253, 251, 248;
        --ml-ink-rgb: 42, 53, 41;

        /* ═══ TYPE ═══
           Outfit, self-hosted, variable, SIL OFL — free for commercial use and
           self-hosting, no attribution required in the page (licence text ships
           at /fonts/Outfit-OFL.txt regardless).

           WHY IT IS A TOKEN AND NOT A HARDCODED FAMILY: Keegan's actual brand
           face is CoFo Sans VF, and the file he was given is an Adobe Fonts
           desktop-sync copy whose EULA does not cover web self-hosting. When he
           takes either legitimate route — publishing it as an Adobe Fonts web
           project on his domain, or buying a webfont licence from Contrast
           Foundry — CoFo replaces Outfit by editing THIS LINE and nothing else.

           Outfit was chosen on measured metrics (cap height 0.676 against
           CoFo's 0.680, full 100–900 axis where Figtree starts at 300 and the
           brand guidance is light/regular weights). Lens verified the letterforms
           this session: see the LN-6 report for what matches and the one tell
           that does not. */
        --ml-font-brand: 'Outfit', system-ui, -apple-system, 'Segoe UI', sans-serif;
      }

      /* One file, the full 100–900 axis. `swap` so text is readable
         immediately on a slow connection and reflows when the face lands —
         the metric match is close enough (0.2% on the wordmark) that the
         reflow is barely perceptible. */
      @font-face {
        font-family: 'Outfit';
        src: url('/fonts/outfit-variable.woff2') format('woff2-variations');
        font-weight: 100 900;
        font-style: normal;
        font-display: swap;
      }

      /* Lens LN-3. Story 1-10 added 8 images across 6 pages, each with its own
         class and its own width rule, and there was no shared floor. The About
         portrait capped at `max-width: 20rem` = 320px, which is WIDER than the
         272px content column at a 320px viewport, so it pushed the whole page
         sideways — the only horizontal overflow in 56 page/width combinations.
         Fixing `.portrait` alone would leave the other seven one careless value
         away from the same bug, and 1-10 is still adding images. This is the
         floor that makes the class impossible. It only ever constrains an image
         that would otherwise exceed its container, so nothing else moves. */
      img {
        max-width: 100%;
        height: auto;
      }

      /* LN-3 F5 / SM-11 (2). ONE RULE, WHERE SIX NEAR-COPIES USED TO BE.
         `.page-img` was written out byte-identically in four page files,
         `.hero-img` was a fifth copy of the same four properties, and
         `.portrait` was a sixth that differed in exactly one value — and the one
         that differed is the one that broke the page, overflowing 320px by 24px.
         That is the whole argument: six copies means five chances to be right
         and one to be wrong, and story 1-10 is still adding images.

         Note the global `img` floor above CANNOT rescue this on its own. A class
         selector beats an element selector, so a bespoke `.portrait { max-width }`
         overrode it — which is precisely how Lens's first attempt at the fix
         failed. The floor and this shared class are doing different jobs. */
      /* ⚠️ LN-6 / 1-15. A PORTRAIT PHOTOGRAPH NEEDS A CAP, AND IT HAS TO BE A
         WIDTH CAP — CAPPING THE HEIGHT COSTS LAYOUT STABILITY.

         THE DEFECT: `width: 100%` is only safe for a LANDSCAPE photograph. 34 of
         the 46 captured images are 2:3 portrait, and a 2:3 portrait at 100% of a
         44rem column paints 704x1056 — measured on a 1280x800 laptop, 1.32
         SCREENS TALL for one photo. The worst already live was the pike drill on
         /services/ at 704x1366 = 1.71 screens. Five of the six placed portraits
         exceeded a full screen; every landscape one sat at 0.47-0.59 and was
         never the problem. Placing the remaining 38 under the old rule would
         have multiplied a measured defect by five, which is why this is fixed
         BEFORE the editorial pass rather than after it.

         ⚠️ WHY NOT `max-height`, WHICH IS THE OBVIOUS FIX: it works visually and
         it MEASURABLY BREAKS G-5/G-6. A height cap only binds if the width is
         free, and `width: auto` makes the used width fall out of whichever
         srcset candidate the browser picked — which is not known until the bytes
         land. Baseline CLS on /services/group-classes/ and /services/handstand/
         at 375px was 0.0000; with `width:auto; max-height:min(72vh,620px)` they
         went to 0.1601 and 0.1140, both past the 0.1 "good" threshold. Attributed
         with layout-shift `sources`: the <h2> and <p> BELOW each image jumped
         because the image box resized after decode. I checked this against a
         build of HEAD rather than assuming I had caused it — I had.

         THE FIX: cap the WIDTH instead. The aspect ratio is fixed, so a width cap
         and a height cap are the same picture — but `width: 100%` resolves
         against the CONTAINER immediately and the height follows from the
         width/height attributes, so the box is exact before the image arrives.
         `.tall` is a modifier, not a seventh copy of the rule: the LN-3 F5 lesson
         was about six DUPLICATE rules, and "this photograph is portrait" is a
         real distinction the author already knows at the call site.

         NO `object-fit: cover` ANYWHERE HERE, on purpose: cropping is an
         editorial decision and these are movement photographs where the whole
         body is the content. A cover-crop takes the feet off a handstand. */
      .page-img,
      .hero-img,
      .portrait {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 6px;
        margin: 1.5rem auto;
      }
      /* 24rem = 384px, which puts a 2:3 portrait at 576px tall — 0.72 of an
         800px laptop screen, the same result the height cap gave, without the
         shift. On a phone the 327px column is already narrower than the cap, so
         this does nothing there: portrait is the natural shape on a portrait
         device, and the defect was only ever a desktop one. */
      .page-img.tall,
      .hero-img.tall {
        max-width: 24rem;
      }
      /* The one genuine per-image override that survives: the portrait is a
         person, not a scene, so it is capped tighter than a scene photograph.
         `min()` rather than a bare 20rem because 20rem = 320px is WIDER than the
         content column at a 320px viewport (Lens's F4).
         `width: 100%` rather than the `width: auto` this used to carry — auto was
         costing 0.026 of measured CLS on /about/ at baseline, for the same
         srcset reason as above. Fixed in passing since the mechanism is now
         understood. */
      .portrait {
        width: 100%;
        max-width: min(20rem, 100%);
      }

      /* SM-11 (1). Body links. Deliberately an ELEMENT selector so every
         component's own class rule still wins on specificity — the nav, the
         footer and the booking button all set their own colour and are
         untouched by this. */
      a {
        color: var(--ml-link);
      }
      a:hover,
      a:focus-visible {
        text-decoration-thickness: 2px;
      }

      /* ═══ LN-6 / story 1-15. THE BRAND TYPE SYSTEM ═══
         GLOBAL, and that is load-bearing rather than lazy. Headings arrive
         through <slot> carrying their OWN astro cid, so a scoped rule here
         compiles to `h1[data-astro-cid-<layout>]` and matches nothing in page
         content. `text-wrap: balance` was sitting in the scoped block below and
         was therefore never reaching a single page heading — a latent no-op
         nobody could see, which is the same shape as the image-rule bug.

         The brand deck's own type register, applied:
         - LIGHT AND REGULAR WEIGHTS, NEVER HEAVY. Headings run 300.
         - Generous letter-spacing on display sizes; slides set headings open.
         - SENTENCE CASE, never ALL CAPS, except the small tracked label style
           the badge lockup uses. */
      body,
      button,
      input,
      select,
      textarea {
        font-family: var(--ml-font-brand);
      }

      h1,
      h2,
      h3,
      h4 {
        font-family: var(--ml-font-brand);
        font-weight: 300;
        letter-spacing: 0.005em;
        text-wrap: balance;
        color: var(--ml-ink);
      }
      h1 {
        font-size: clamp(2rem, 1.55rem + 2.2vw, 3rem);
        line-height: 1.12;
        letter-spacing: -0.005em; /* display sizes need slightly less, not more */
        margin: 0 0 0.6em;
      }
      h2 {
        font-size: clamp(1.5rem, 1.3rem + 1vw, 1.95rem);
        line-height: 1.2;
        margin: 2.75rem 0 0.7rem;
      }
      h3 {
        font-size: clamp(1.15rem, 1.08rem + 0.35vw, 1.3rem);
        line-height: 1.3;
        font-weight: 400; /* 300 goes too faint at this size */
        margin: 1.9rem 0 0.5rem;
      }

      /* The brand's accent gesture: a short orange rule under section heads.
         Orange as a BORDER, which is what it is licensed to do here — this is
         the one place the accent appears on a text-bearing element without
         ever being the text itself. */
      main h2::after {
        content: '';
        display: block;
        width: 2.25rem;
        height: 3px;
        margin-top: 0.6rem;
        border-radius: 2px;
        background: var(--ml-accent);
      }

      /* The tracked uppercase label from the badge lockup. Small, sparing. */
      .brandline,
      .eyebrow {
        font-size: 0.8125rem;
        font-weight: 500;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        color: var(--ml-muted);
      }

      /* ═══ THE FULL-BLEED GRID — ONE DEFINITION, FOUR USERS ═══
         The page is a three-track grid: a flexible gutter, the reading measure,
         another flexible gutter. Anything on `content` sits on the measure;
         anything on `full` reaches both edges of the page. `body`, `main`,
         `.band` and `.site-footer` all share THIS template and nothing else
         defines one, so the bleed cannot drift between them.

         🔴 WHY THIS REPLACED `margin-inline: calc(50% - 50vw)` (2026-08-02).
         The vw version was elegant, needed no wrapper, and was WRONG in a way
         no amount of Chromium checking could show. **`vw` ignores the
         scrollbar** — CSS Values 4 resolves viewport units as though scrollbars
         do not exist. So with a CLASSIC scrollbar (the default on Windows, and
         on any Mac set to 'always show scroll bars') `100vw` is ~15px wider
         than the content area, and every band and the footer overhung it:
         measured -7..1273 inside a 1265px area, i.e. horizontal scroll on every
         page of the site.

         It could not be reproduced locally: macOS defaults to overlay
         scrollbars and headless Chromium force-hides them, so a 56-combination
         sweep across seven widths reported 0 overflow and was structurally
         incapable of seeing it. It was proven instead with a static repro of
         these exact declarations inside a deliberately shortened container.

         The grid has no such blind spot, because **percentage tracks resolve
         against the container's content box, which already excludes the
         scrollbar.** `min(measure, 100% - 2 gutters)` is therefore correct by
         construction at every width, on every platform, with or without a
         scrollbar — rather than correct-looking on the one configuration the
         test machine happened to have. */
      :root {
        --ml-measure: 44rem; /* the reading column */
        --ml-gutter: 1.5rem; /* minimum breathing room at narrow widths */
      }
      body,
      main,
      .band,
      .site-footer {
        display: grid;
        grid-template-columns:
          [full-start] 1fr
          [content-start] min(
            var(--ml-measure),
            calc(100% - var(--ml-gutter) - var(--ml-gutter))
          )
          [content-end] 1fr
          [full-end];
      }
      /* Default: everything sits on the measure. */
      body > *,
      main > *,
      .band > *,
      .site-footer > * {
        grid-column: content;
      }
      /* The three that break out. `body > main` rather than a bare `main` on
         purpose: `main` alone ties with `body > *` on specificity and would be
         decided by source order, which is exactly the kind of fragility this
         refactor exists to remove. */
      body > main,
      .band,
      .site-footer {
        grid-column: full;
      }

      /* ═══ SAGE SURFACE ═══
         The third brand colour, and the one that breaks the page out of a
         single uninterrupted column: a band that reaches both page edges while
         its CONTENT stays on the same measure as everything else. It gets that
         from the grid above — `grid-column: full` for the band, `content` for
         its children — so there is no inline padding to keep in sync here.

         ink on sage is 8.12:1 and muted on sage is 4.92:1 — both cleared, which
         is why --ml-muted was derived against sage rather than paper alone. */
      .band {
        background: var(--ml-surface);
        padding-block: 2.25rem;
        margin-block: 2.75rem;
      }
      .band > :first-child {
        margin-top: 0;
      }
      .band > :last-child {
        margin-bottom: 0;
      }
      /* Inside a sage band the hairline needs to be darker than the band, not
         lighter — the paper-tinted rule disappears against it. */
      .band hr,
      .band .hours-row {
        border-color: var(--ml-muted);
      }
      /* The orange section rule CANNOT follow a heading into a sage band —
         accent on surface is 2.11:1, the one pairing the brand contract rules
         out outright. It is a 3px decorative bar so no WCAG criterion is
         breached, but at 2.11 it reads as muddy rather than as an accent, which
         is the practical reason the rule exists. Ink on sage is 8.12:1. */
      .band h2::after {
        background: var(--ml-ink);
      }

      /* Focus: orange ring. A border/outline is a licensed use of the accent,
         and it is the one thing on the page that should interrupt.
         Measured on the two grounds it can land on: 3.22:1 on paper and 3.85:1
         on the ink footer, both clearing the 3.0 that WCAG 1.4.11 asks of a
         non-text indicator. The third ground is handled directly below. */
      a:focus-visible,
      button:focus-visible,
      summary:focus-visible,
      [tabindex]:focus-visible {
        outline: 2px solid var(--ml-accent);
        outline-offset: 2px;
        border-radius: 2px;
      }
      /* ⚠️ THE RING CANNOT STAY ORANGE INSIDE A BAND — 2.11:1 ON SAGE, WHICH
         FAILS 1.4.11's 3.0 FOR A FOCUS INDICATOR.
         This is the same 2.11 that already forced `.band h2::after` to ink a few
         rules up; the heading rule was caught when the first band shipped and the
         focus ring was not, because the home page's band happened to be the only
         one and the defect only appears once you TAB INTO a band rather than look
         at it. 1-15's section-rhythm pass took the site from one band to six, all
         of them containing links, so a keyboard user would have met an
         effectively invisible focus ring on most pages of the site.
         Ink on sage is 8.12:1. Same fix, same reason, same value as the heading
         rule — if the band surface ever changes, all three move together. */
      .band a:focus-visible,
      .band button:focus-visible,
      .band summary:focus-visible,
      .band [tabindex]:focus-visible {
        outline-color: var(--ml-ink);
      }
    </style>

    <style>
      body {
        text-wrap: pretty;
        /* font-family now comes from the global type block — --ml-font-brand. */
        /* ⚠️ `max-width: 44rem; margin: 0 auto; padding-inline: 1.5rem` USED TO
           LIVE HERE and is now the grid's job — see THE FULL-BLEED GRID in the
           global block. The measure and the gutter are the `--ml-measure` and
           `--ml-gutter` tracks, so body is full width and only sets its
           VERTICAL padding. Setting a max-width here again would re-break the
           bleed, because the bands resolve their edges from this element.

           `margin: 0` is REQUIRED, not tidiness: dropping `margin: 0 auto`
           handed body back to the UA default of `margin: 8px`, and because the
           bands bleed to the edges of THIS element they stopped 8px short on
           both sides. Caught by measuring the band's box against the content
           box (8..1257 inside 1265) — it is a small enough inset to look
           deliberate in a screenshot. */
        margin: 0;
        padding-block: 2rem 4rem;
        line-height: 1.65;
        color: var(--ml-ink);
        background: var(--ml-paper);
      }
      /* `h1,h2,h3 { text-wrap: balance }` USED TO LIVE HERE and never applied —
         scoped, while every heading arrives through <slot> with its own cid.
         It is in the global block now, along with the rest of the type system. */
      code {
        background: var(--ml-code);
        padding: 0.15em 0.4em;
        border-radius: 3px;
      }
      .site-updated {
        margin-top: 3rem;
        padding-top: 1rem;
        border-top: 1px solid var(--ml-rule);
        font-size: 0.875rem;
        color: var(--ml-muted);
      }
    </style>
  </head>

  <body>
    <Nav current={Astro.url.pathname} />

    {/* The skip link in Nav targets this id. A landmark <main> is also how a
        screen-reader user jumps past the header on every page. */}
    <main id="main">
      <slot />
    </main>

    {/* Visible last-updated date. Concrete on-page facts are what the
        controlled evidence actually supports (reconciliation § 2). */}
    <p class="site-updated">
      Last updated <time datetime={updatedISO}>{updatedHuman}</time>
    </p>

    {/* Story 1-5. Visible NAP on EVERY page — the corroboration Google looked
        for and did not find when it rejected Keegan's profile edits. */}
    <Footer />

    <slot name="body-end" />
  </body>
</html>
