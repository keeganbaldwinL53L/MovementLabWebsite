---
// Story 1-6. The launch navigation.
//
// FOUR ITEMS, AND THE SHORTNESS IS THE DECISION (Manny A2, Keegan D3).
// The old WordPress nav carried eight: Home, Services, Chiropractic Treatment,
// Mobility Coaching, Group Classes, Handstand Coaching, About Me, Book Here.
// That spread a visitor's attention across four service pages when one of them
// is the business. The launch nav is Home · Chiropractic & Movement · About ·
// Book, and everything else stays findable through the services hub and links
// in the body.
//
// ⚠️ BLOG IS DELIBERATELY ABSENT (D3). It is built and reachable at /blog/, and
// it joins the nav once there are posts worth showing. Keegan: "we can start
// making content but as a back up we can just leave it off at launch." Adding it
// here early is how a launch ends up with an empty blog in the primary nav.
import { Image } from 'astro:assets';
import business from '../data/business.json' with { type: 'json' };
import mark from '../assets/brand/mark.png';

interface Props {
  /** Pathname of the current page, so the nav can mark where you are. */
  current: string;
}

const { current } = Astro.props;

const LINKS = [
  { href: '/', label: 'Home' },
  { href: '/services/chiropractic-treatment/', label: 'Chiropractic & Movement' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Book' },
];

// Trailing slashes everywhere, matching astro.config's trailingSlash: 'always'.
// A link written without one costs a redirect hop on every click (G-1).
const isCurrent = (href: string) => current === href;
---

{/* Skip link first in the DOM: a keyboard or screen-reader user should not have
    to walk the whole nav on every page to reach the content. */}
<a class="skip-link" href="#main">Skip to content</a>

<header class="site-header">
  {/* LN-6 / 1-15. The mark rides ALONGSIDE the name, and the name stays real
      text. It is tempting to drop in the logo lockup artwork instead, but the
      lockup reads "Movement Lab" while the business name is "Keegans Movement
      Lab" — and that name matching the Google Business Profile CHARACTER FOR
      CHARACTER is the entire mechanism story 1-5 exists to serve. Replacing the
      text with an image that says something shorter would quietly undo it, and
      cost the alt-text-free crawlable name at the top of every page. So: mark
      as decoration, name as text. */}
  {/* SM-14. This was a hand-written <img> for a while, working around the build
      gate rather than the markup: <Image alt=""> serialises to a BARE boolean
      `alt`, and check-build.mjs matched /\salt="([^"]*)"/, so it reported
      correct markup as "no alt attribute at all". THE GATE IS FIXED — it now
      reads an attribute in all four shapes HTML allows, so the paved road is
      open again and the workaround is gone.

      Worth keeping, because it is the reason to care: the hand-written version
      shipped the raw 512x512 PNG, 27,681 bytes, to display at 30px, in the
      header of all 8 pages. Through astro:assets the same mark is a 936-byte
      webp — 30x smaller. A build gate that pushes authors off astro:assets
      costs real bytes, which is why the blind spot was worth fixing rather
      than working around. */}
  <a class="brand" href="/">
    {/* eager, not astro's default lazy: this sits in the header of every page,
        above the fold on all of them, and it is 936 bytes. */}
    <Image
      src={mark}
      alt=""
      aria-hidden="true"
      loading="eager"
      width={30}
      height={30}
      class="brand-mark"
    />
    <span>{business.name}</span>
  </a>

  <nav aria-label="Main">
    <ul>
      {
        LINKS.map((l) => (
          <li>
            <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--ml-paper);
    color: var(--ml-ink);
    padding: 0.6rem 1rem;
    z-index: 10;
    border: 1px solid var(--ml-deep);
    border-radius: 4px;
  }
  /* Lens LN-3. On focus this returns to normal flow rather than overlaying.
     As an overlay its background was the SAME colour as the page and its
     bottom edge landed mid-glyph on "Keegans Movement Lab", so the first
     thing a keyboard user ever saw was a chip that appeared to slice the
     brand in half. Taking flow position pushes the header down instead, so
     nothing is ever covered. Unfocused it stays parked off-screen exactly as
     before, and no sighted mouse user sees any change. */
  .skip-link:focus {
    position: static;
    left: auto;
    display: inline-block;
    margin-bottom: 1rem;
    /* ⚠️ LN-6 2026-08-02. body is a GRID now, so on focus this becomes a grid
       item and `display: inline-block` is blockified — without this it would
       stretch the full width of the reading measure and the chip would become a
       704px bar. `justify-self: start` keeps it sized to its own text, which is
       what the LN-3 fix above is describing. Inert in a non-grid parent, so it
       costs nothing if this ever moves. */
    justify-self: start;
  }
  /* Story 1-16, from Keegan on the live site: "make the banner at the top a bit
     thicker, and the logo on the top left looks a bit off from the centre
     (looks too high) including the title".

     BOTH HALVES WERE REAL AND MEASURABLE, which is worth recording because "looks
     too high" is the kind of report that gets treated as taste:
       header box            0..59, centre 30
       brand lockup box      0..30, centre 15   <- 15px above the header's centre
       nav box              13..38, centre 25   <- and 10px off the brand
     Two separate causes.

     1. THE PADDING WAS ONE-SIDED. `padding-bottom: 1.25rem` with no top pair, so
        the content sat flush against the top edge of the band. Invisible while
        body supplied 2rem of its own padding above it; the moment 1-16 gave the
        home page a full-bleed hero, body's top padding went to 0 and the header
        had nothing holding it off the top of the viewport. Now symmetric, and
        larger, which is the "thicker" half.
     2. `align-items: baseline` CANNOT CENTRE A LOCKUP. It lines up text
        baselines, so a 30px graphic mark and 15px nav text end up on different
        centre lines by construction — the mark hangs off the text baseline
        rather than sitting beside it. `center` is what a mark-plus-wordmark
        lockup wants; the baseline value was fine when the header was text only. */
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-block: clamp(0.95rem, 2vw, 1.7rem);
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--ml-rule);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 600; /* the brand deck never uses heavy weights */
    font-size: 1.0625rem;
    letter-spacing: 0.005em;
    text-decoration: none;
    color: var(--ml-ink);
  }
  .brand-mark {
    /* CORRECTED SM-14 — this used to say "the global `img` rule sets
       width:100%, so the mark must opt out or it fills the header". It does
       not: BaseLayout's global rule is `max-width: 100%; height: auto`, and
       measured with this class hook deliberately broken the mark still rendered
       30x30 off its width/height attributes alone. So these two lines are
       belt-and-braces, not the thing holding the size. Keeping them anyway —
       they cost nothing and they pin the size if an attribute ever goes
       missing — but nobody should read them as load-bearing. */
    width: 30px;
    height: 30px;
    margin: 0;
    flex: none;
    border-radius: 0;
  }
  .site-header nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.9375rem;
  }
  .site-header nav a {
    color: var(--ml-muted);
    text-decoration: none;
  }
  .site-header nav a:hover,
  .site-header nav a:focus-visible {
    color: var(--ml-ink);
    text-decoration: underline;
  }
  /* Where you are now, marked for sighted users as well as assistive tech. */
  .site-header nav a[aria-current='page'] {
    color: var(--ml-ink);
    font-weight: 600;
  }
</style>
