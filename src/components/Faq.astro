---
// Story 1-6. A reusable FAQ block.
//
// ⚠️ THIS COMPONENT EMITS BOTH HALVES FROM ONE ARRAY, AND THAT IS THE POINT.
// Spec G-8: FAQPage schema goes ONLY where the questions genuinely appear in the
// page body. Marking up questions a visitor cannot see is precisely the mismatch
// Google penalises. Passing the entries to a schema builder in the page head and
// separately writing the visible questions in the body would let the two drift
// the first time someone edits one of them.
//
// So the visible list and the JSON-LD are generated from the same `entries`
// prop, by the same component. They cannot disagree. (Same shape as the
// analytics flag in src/lib/analytics.mjs — one source, two consumers.)
//
// JSON-LD in the body is valid and is read by Google; it does not need to be in
// the head, and putting it here is what keeps it welded to the visible content.
//
// 🔴 THE CHIROPRACTIC FAQ IS PORTED VERBATIM AND IS OUT OF REWRITE SCOPE.
// It is the most citation-shaped asset the site owns: real questions, answers
// that lead with the answer, prices visible in the text. Anyone MAY ADD a
// question. Nobody may reword an existing one as a side effect of a content
// pass — that is a deliberate decision with a named owner.
import { faqPage } from '../lib/schema.mjs';

interface Props {
  /** Real questions with real answers. Rendered AND marked up from this array. */
  entries: { question: string; answer: string }[];
  heading?: string;
  /** Heading level, so the block nests correctly wherever it is used (G-7). */
  level?: 2 | 3;
  /**
   * Emit the FAQPage JSON-LD alongside the visible list. Defaults TRUE, which
   * is the behaviour every existing caller relies on.
   *
   * ⚠️ SET THIS FALSE ON A SECOND INSTANCE OF QUESTIONS THAT ARE ALREADY MARKED
   * UP ELSEWHERE ON THE SITE, AND NOWHERE ELSE. Added for ST-62 H11, where
   * Keegan asked for a reduced version of the treatment page's questions on the
   * home page. Reusing this component as-is would have published a SECOND
   * FAQPage whose entries duplicate four already marked up on
   * /services/chiropractic-treatment/. [INFERRED, not verified against current
   * Google behaviour] duplicating marked-up Q&A across two URLs on one site is
   * the kind of thing that gets rich results suppressed for both, so the
   * conservative default is to mark up the canonical page only.
   *
   * This does NOT weaken the rule above: the visible list is still generated
   * from the same array, so the two cannot disagree. It only decides whether
   * THIS instance is the one that claims the markup.
   */
  schema?: boolean;
}

const {
  entries,
  heading = 'Frequently Asked Questions',
  level = 2,
  schema: withSchema = true,
} = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
const schema = withSchema ? faqPage(entries) : null;
---

{/* A stable anchor so other pages can link straight to the questions —
    the home page's "More questions about treatment" does exactly that.
    One FAQ block per page, so this id stays unique. */}
<section class="faq" id="faq">
  <Heading>{heading}</Heading>

  {
    entries.map((e) => (
      <details class="faq-item">
        <summary>{e.question}</summary>
        <p>{e.answer}</p>
      </details>
    ))
  }

  {/* Generated from the same array the visitor just read. */}
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
</section>

<style>
  .faq {
    margin: 2.5rem 0;
  }
  .faq-item {
    border-bottom: 1px solid var(--ml-rule);
    padding: 0.85rem 0;
  }
  .faq-item summary {
    cursor: pointer;
    font-weight: 600;
    /* The marker is the only affordance saying these open, so keep it. */
    list-style-position: outside;
  }
  .faq-item summary:focus-visible {
    outline: 2px solid var(--ml-deep);
    outline-offset: 2px;
  }
  .faq-item p {
    margin: 0.75rem 0 0.25rem;
  }
</style>
