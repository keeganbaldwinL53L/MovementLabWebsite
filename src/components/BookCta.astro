---
// Story 1-4. A deep link to exactly ONE appointment type.
//
// Preferred over an embed everywhere except the Book page: no JavaScript, no
// resize dance, no layout shift, and it keeps the widget to a single page.
//
// The price and label come from src/data/services.json via the slug — a page
// may NOT pass its own price text. Prices appear on the site, in schema and on
// a Google profile, so one source is the only way they stay in agreement.
import { serviceBySlug } from '../lib/cliniko.mjs';

interface Props {
  /** A slug from src/data/services.json. An unknown slug fails the build. */
  slug: string;
  /** Override the link text. Defaults to the service label. */
  label?: string;
  /**
   * Show duration and price beside the label. Off for classes, which have no
   * price — and now off EVERYWHERE, by Keegan 2026-08-03: "the booking butons
   * don't need to all show the price right next to them."
   *
   * He was right that it had stopped earning its place. Every instance that
   * carried it sat directly under something that already stated the price: the
   * three service CTAs each follow an <h3> reading "— 1 hour, $120", and the
   * services-page button sits immediately below the pricing table. The button
   * was repeating a number the eye had just read.
   *
   * Kept as a prop rather than deleted: it is the right behaviour for a CTA
   * that appears WITHOUT its price nearby, which is a page we may yet write.
   */
  showDetail?: boolean;
}

const { slug, label, showDetail = false } = Astro.props;

const service = serviceBySlug(slug);

// Keegan, 2026-08-03: "i noticed all the buttons send to jakes booking page,
// maybe send them to my own booking page instead."
//
// They used to deep-link straight out to Cliniko. Those links were correct —
// scoped to Keegan's business + practitioner + one appointment type, so nobody
// could reach another practitioner — but they left his site, and the address
// bar then read `jake-williams-chiropractic.au1.cliniko.com`, because the
// Cliniko account belongs to the shared Restore Health Clinic.
//
// /contact/ already embeds the same widget, scoped the same way, so the whole
// journey now stays on keegansmovementlab.com. `#book` lands the reader on the
// widget rather than the top of the page.
//
// ⚠️ THE EXTERNAL URL BUILDER IS STILL LOAD-BEARING — do not delete it. The
// embed on /contact/ is built with it, and scripts/check-booking-links.mjs
// exercises it against the real Cliniko account to catch the silent failure
// where a recreated appointment type gets a new id and a stale link quietly
// falls back to a wider list.
//
// TRADE-OFF, stated because it is a real one: the old link pre-selected the
// appointment type and this does not — the reader picks from Keegan's types on
// arrival. The button label says which one they came for. Pre-selecting through
// the embed would mean rewriting the iframe src client-side, on the page whose
// resize handshake caused the 451px mobile clipping in LN-4, so it is not worth
// the risk for one saved click.
const href = '/contact/#book';

// price === null means Cliniko has no billable item set. Render nothing rather
// than inventing a number or printing "$null".
const priceText = service.price === null ? null : `$${service.price}`;
---

<p class="book-cta">
  <a href={href}>
    {label ?? `Book ${service.label.toLowerCase()}`}
  </a>
  {
    showDetail && (
      <span class="book-cta-detail">
        {service.durationMinutes} min{priceText ? ` · ${priceText}` : ''}
      </span>
    )
  }
</p>

<style>
  .book-cta {
    margin: 1rem 0;
  }
  .book-cta a {
    display: inline-block;
    background: var(--ml-accent);
    color: var(--ml-paper);
    padding: 0.6rem 1.2rem;
    border-radius: 4px;
    text-decoration: none;

    /* Lens LN-3, closing UD-21. Keegan: "do the one that keeps my colours."
       --ml-paper on --ml-accent is 3.53:1. WCAG AA asks 4.5:1 for normal text
       but only 3:1 for LARGE text, and large means >=24px at any weight OR
       >=18.66px at weight >=700. At 16px/600 this was normal text and failed;
       at 19px/700 it is large text and passes, with the brand hex untouched.
       DO NOT drop either value below these without re-checking the ratio —
       they are load-bearing for conformance, not styling preference. */
    font-size: 1.1875rem; /* 19px — clears the 18.66px large-text threshold */
    font-weight: 700; /* 600 does NOT qualify; large text needs 700 */

    /* LN-6. On the REAL brand orange #FF4D00 this pair measures 3.22:1, down
       from 3.53 on the old approximation. It still clears the 3.0 large-text
       bar, so the UD-21 fix survives the palette change — but the headroom is
       now 0.22, so 19px/700 is a FLOOR. Do not reduce either value. */
    letter-spacing: 0.005em;
  }
  .book-cta a:hover,
  .book-cta a:focus-visible {
    background: var(--ml-deep);
  }
  .book-cta-detail {
    margin-left: 0.75rem;
    color: var(--ml-muted);
    font-size: 0.9375rem;
    /* Lens LN-3. At 375px — the most common phone width — the button plus this
       span overflowed the line and the break landed INSIDE the phrase, leaving
       "· $120" orphaned on its own line under "60 min". It is a price, so a
       fragment reads as a mistake. Keeping it unbreakable makes the whole
       phrase move to the next line together, which is what 320px already did.
       Verified at 320 / 375 / 414 / 1280. */
    white-space: nowrap;
  }
</style>
