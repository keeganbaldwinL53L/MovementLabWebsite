---
// Story 1-5. The visible NAP block. Renders on EVERY page via BaseLayout.
//
// This is the corroboration Google asked for and did not find. Before this,
// Keegan's phone appeared on zero pages and his address on zero pages, which is
// why his Business Profile edits were rejected. The schema in the head is the
// machine half; this is the half a person and a crawler both read.
//
// Every value comes from src/data/business.json. Nothing here is typed by hand:
// the name, phone and address must match the Google profile CHARACTER FOR
// CHARACTER, and a second copy is how two records drift apart.
import business from '../data/business.json' with { type: 'json' };
import hours from '../data/hours.json' with { type: 'json' };

const { address } = business;

// Group the nine ranges by day so Tuesday and Thursday read as one line with a
// break ("8:00am–2:00pm, 4:30pm–8:00pm") rather than as two separate days.
const DAY_ORDER = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
const byDay = DAY_ORDER.map((day) => ({
  day,
  ranges: hours.openingHours.filter((r) => r.day === day),
})).filter((d) => d.ranges.length > 0);

const fmt = (t) => {
  const [h, m] = t.split(':').map(Number);
  const suffix = h < 12 ? 'am' : 'pm';
  const h12 = h % 12 === 0 ? 12 : h % 12;
  return m === 0 ? `${h12}${suffix}` : `${h12}:${String(m).padStart(2, '0')}${suffix}`;
};
---

<footer class="site-footer">
  <div class="nap">
    <p class="nap-name">{business.name}</p>

    <p class="nap-address">
      <span>{address.venue}</span><br />
      <span>{address.streetAddress}</span><br />
      <span>{address.addressLocality} {address.addressRegion} {address.postalCode}</span>
    </p>

    <p class="nap-contact">
      {/* tel: uses the E.164 form so it dials correctly from overseas, while
          the visible text stays in the local format people recognise. */}
      <a href={`tel:${business.phoneE164}`}>{business.phone}</a><br />
      <a href={`mailto:${business.email}`}>{business.email}</a>
    </p>
  </div>

  <div class="hours">
    <p class="hours-heading">Opening hours</p>
    <dl>
      {
        byDay.map(({ day, ranges }) => (
          <div class="hours-row">
            <dt>{day}</dt>
            <dd>{ranges.map((r) => `${fmt(r.opens)}–${fmt(r.closes)}`).join(', ')}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <p class="footer-legal">
    <a href="/privacy/">Privacy policy</a>
    <span class="sep">·</span>
    <span>ABN {business.abn}</span>
  </p>
</footer>

<style>
  /* ═══ LN-6 / 1-15. THE FOOTER IS THE PAGE'S TERMINAL, SO IT GETS A SURFACE ═══
     Before this it was paper on paper with a hairline above it: legible, and
     completely unbranded — eight pages that simply stopped. Deep green is the
     brand's primary dark and it is the one move that gives every page a defined
     end without adding a single element.

     NO NEW COLOUR VALUES ARE INTRODUCED HERE, which is the tell that the palette
     is right: on ink, paper carries the primary text at 12.40:1 and SAGE carries
     the secondary at 8.12:1 — both already brand tokens, both computed at the
     top of BaseLayout. Contrast is symmetric, so these are the same two ratios
     the palette was signed off on, read the other way round. --ml-muted is
     deliberately NOT used below: it is derived for LIGHT grounds and would be
     near-invisible here, which is exactly the trap MLW-LRN-23 describes.

     THE FULL-BLEED IS `.band`'s IDIOM, DELIBERATELY REUSED — see the long note
     on `.band` in BaseLayout for why `margin-inline: calc(50% - 50vw)` reaches
     the viewport edge from inside a centred column. If one of the two ever
     changes, change both. The negative bottom margin cancels body's 4rem bottom
     padding so the surface runs to the end of the document rather than floating
     above a strip of paper.

     Scoped rather than global, and that IS safe here: the Astro scoping bug that
     bit three agents on this project applies to SLOTTED content carrying its own
     cid. This markup is the component's own, so it carries this file's cid and
     the rules match. */
  .site-footer {
    margin-top: 4rem;
    margin-inline: calc(50% - 50vw);
    margin-bottom: -4rem;
    padding: 2.75rem calc(50vw - 50% + 0.25rem) 3rem;
    background: var(--ml-ink);
    color: var(--ml-paper);
    font-size: 0.9375rem;
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 40rem) {
    .site-footer {
      grid-template-columns: 1fr 1fr;
    }
    .footer-legal {
      grid-column: 1 / -1;
    }
  }
  .nap-name {
    font-weight: 700;
    margin: 0 0 0.5rem;
  }
  .nap-address,
  .nap-contact {
    margin: 0 0 0.75rem;
    line-height: 1.5;
  }
  .hours-heading {
    font-weight: 700;
    margin: 0 0 0.5rem;
  }
  .hours dl {
    margin: 0;
    /* LN-6, closing UD-22. Keegan: "i prefer tighter atm."
       The rows are `justify-content: space-between`, so without a cap they
       stretch to the full column and on desktop a short row put `Friday` and
       `8am–5pm` about 220px apart — the eye has to travel to pair a day with
       its time, and mis-pairing this particular block is what sends someone to
       a locked door. Capping the LIST rather than changing the layout keeps the
       footer column its full width.
       It helps most exactly where his hours are hardest: Tuesday and Thursday
       each carry TWO time blocks around the 14:00–16:30 break, so they are the
       longest rows and the uncapped version stretched them furthest.

       ⚠️ `max-content`, NOT a fixed rem cap. I first proposed `max-width: 22rem`
       in UD-22 and it turned out to be a NO-OP: the footer's hours column is
       only ~336px at every desktop width, narrower than 22rem, so the cap never
       engaged and the gap stayed at 225px. `max-content` sizes the list to its
       own widest row — Tuesday, the two-block one — so it is self-tuning and
       cannot go stale if the hours ever change. `max-width: 100%` keeps it
       inside the column on a phone. */
    width: max-content;
    max-width: 100%;
  }
  .hours-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.15rem 0;
  }
  /* Sage, not --ml-muted. The day name is the secondary half of the pair and
     needs to sit back from the time without becoming hard to read — sage on ink
     is 8.12:1. --ml-muted here would be roughly 1.3:1 and effectively invisible. */
  .hours-row dt {
    color: var(--ml-surface);
  }
  .hours-row dd {
    margin: 0;
    text-align: right;
  }
  .footer-legal {
    margin: 0;
    color: var(--ml-surface);
  }
  .sep {
    margin: 0 0.5rem;
  }
  .site-footer a {
    color: inherit;
  }
</style>
