---
// Story 1-4. The full Cliniko booking widget.
//
// ⚠️ ONE PER PAGE, MAXIMUM. Cliniko's own snippet hard-codes a single element
// id and its resize listener resolves that id GLOBALLY, so pasting it twice
// makes both iframes post resize messages, both handlers grab the same element,
// and one frame resizes to the other's height (VG-1, read verbatim off the
// live /contact/ page).
//
// This component fixes that properly rather than relying on the rule: the id is
// unique per instance and the listener only accepts messages whose source IS
// this iframe's contentWindow. So two on a page would work. The "one per page"
// guidance still stands as a design preference — deep links are lighter
// everywhere else — but a mistake is no longer silently disfiguring.
import { buildBookingUrl, serviceBySlug } from '../lib/cliniko.mjs';

interface Props {
  /** Restrict to these service slugs. Omit for all of Keegan's types. */
  slugs?: string[];
  title?: string;
  /**
   * Reserved vertical space before the iframe reports its height (spec G-6).
   * An unsized embed is a main cause of layout shift.
   *
   * TWO VALUES, BECAUSE THE WIDGET IS TWICE AS TALL ON A PHONE. A single
   * reservation cannot serve both: 700px over-reserved desktop by ~80px AND
   * under-reserved mobile by ~450px at the same time.
   */
  minHeight?: number;
  /** Reservation at >= 40rem, where the widget lays out much shorter. */
  minHeightWide?: number;
}

// ⚠️ THESE NUMBERS ARE MEASURED, AND THEY DO NOT GO STALE. READ WHY BEFORE
// CHANGING THEM.
//
// Lens (SM-13) declined to hard-code a reservation on the reasonable grounds
// that "the widget's height is a function of how many services are listed, so
// any number written today goes stale the first time the service list changes."
// I measured that function instead of guessing at it, driving the real widget
// with 1..5 appointment types. It is NOT linear, and the non-linearity is the
// whole answer:
//
//        types:      1     2     3     4     5
//    relative :    568   802  1036  1141  1141
//
// The height PLATEAUS at four types — the service list starts scrolling inside
// the widget rather than growing the frame. Keegan already lists five, so he is
// past the plateau: adding a sixth service changes the height by zero. That is
// what makes a fixed reservation safe here, and it is the opposite of what we
// both assumed.
//
// ⚠️ MEASURE IN CONTEXT, NOT IN A HARNESS — I got this wrong first. My isolated
// test page had no body padding, so the iframe was ~48px wider than it is on
// /contact/, the widget laid out shorter, and every number came out 10-45px
// low. Lens's figures, taken from the real page, are the correct ones and are
// what these defaults use:
//
//      320px -> 1172    375px -> 1151    414px -> 1140    >=768px -> 665
//
// So: 1175 narrow (covers the 320px worst case) and 665 wide. Over-reserving by
// a few px is deliberate — whitespace before load beats an upward jump.
//
// RE-MEASURE IF: the widget is scoped to FEWER than four types (below the
// plateau the height really is a function of count), or Cliniko restyles the
// booking flow. The measurement harness is one page with an iframe and a
// message listener — see the SM-13 receipt.
const { slugs = [], title = 'Book an appointment', minHeight = 1175, minHeightWide = 665 } =
  Astro.props;

// serviceBySlug throws on an unknown slug, so a typo fails the build rather
// than silently widening the booking scope.
const appointmentTypeIds = slugs.map((s) => serviceBySlug(s).appointmentTypeId);
const src = buildBookingUrl({ appointmentTypeIds, embedded: true });

// Unique per instance. crypto.randomUUID is available in the Node build.
const frameId = `cliniko-${crypto.randomUUID().slice(0, 8)}`;
---

<section
  id="book"
  class="cliniko-booking"
  aria-label={title}
  style={`--cliniko-min-h:${minHeight}px; --cliniko-min-h-wide:${minHeightWide}px`}
>
  <div class="cliniko-frame-wrap">
    <iframe
      id={frameId}
      src={src}
      title={title}
      loading="lazy"
      scrolling="auto"
      frameborder="0"
      allow="payment"></iframe>
  </div>

  <noscript>
    {/* SM-28: a full stop rather than the colon the ten list items took. This
        one is an instruction followed by its reason, not a label followed by a
        gloss, so a colon would promise an explanation of the booking page and
        then not give one. The dash had to go either way: it is the
        clause-joining em-dash, on outward-facing copy.

        Worth knowing if you ever sweep for this again: `</a>` and the dash sit
        on SEPARATE SOURCE LINES here, so a line-based grep of src/ cannot see
        this construction at all. It is only visible in built HTML. */}
    <p>
      <a href={buildBookingUrl({ appointmentTypeIds })} rel="noopener">
        Open the booking page
      </a>
      . The embedded booking form needs JavaScript.
    </p>
  </noscript>
</section>

<script is:inline define:vars={{ frameId }}>
  (function () {
    var frame = document.getElementById(frameId);
    if (!frame) return;
    window.addEventListener('message', function (e) {
      // SCOPED, unlike Cliniko's own snippet: only react to messages from THIS
      // iframe. Without this, a second embed on the page resizes the first.
      if (!frame.contentWindow || e.source !== frame.contentWindow) return;

      // Lens LN-4. Cliniko does NOT send a bare number. Captured off the live
      // widget on staging, verbatim: "cliniko-bookings-resize:1151".
      // `parseInt` on that returns NaN because the string starts with "c", so
      // the height was never once set and the frame sat at its 700px
      // reservation forever. At 375px the widget asks for 1151px, so 451px of
      // the booking form was cut off — reachable only by scrolling INSIDE the
      // frame, which almost nobody does on a phone. Desktop hid it: there the
      // widget asks for 665px and fits under the reservation.
      // Match Cliniko's actual protocol and take the number from it.
      var m = /^cliniko-bookings-resize:(\d+)$/.exec(String(e.data));
      if (!m) return;
      var h = parseInt(m[1], 10);
      if (h > 0) frame.style.height = h + 'px';
    });
  })();
</script>

<style>
  .cliniko-booking {
    margin: 2rem 0;
  }
  /* Reserves the space up front so the page does not jump when the iframe
     reports its real height (spec G-6).
     The reservation is a MEDIA QUERY, not one number, because the widget is
     roughly twice as tall below 40rem — see the measured table above. The
     breakpoint matches the 768px column of that measurement. */
  .cliniko-frame-wrap {
    width: 100%;
    min-height: var(--cliniko-min-h);
  }
  .cliniko-booking iframe {
    width: 100%;
    border: 0;
    display: block;
    min-height: var(--cliniko-min-h);
  }
  @media (min-width: 40rem) {
    .cliniko-frame-wrap,
    .cliniko-booking iframe {
      min-height: var(--cliniko-min-h-wide);
    }
  }
</style>
