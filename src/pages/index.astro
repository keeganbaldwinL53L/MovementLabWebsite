---
// Story 1-1 spike page. No real content: this exists only to prove the
// Astro -> GitHub -> Hostinger deploy chain end to end.
// The DEPLOY_STAMP line below is the one AC5 changes to test push-to-visible.
const MARKER = 'MLW-SPIKE-1';
const DEPLOY_STAMP = 'deploy-stamp: 002';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Movement Lab — deploy chain spike</title>
    <style>
      body {
        text-wrap: pretty;
        font-family: system-ui, -apple-system, sans-serif;
        max-width: 40rem;
        margin: 4rem auto;
        padding: 0 1.5rem;
        line-height: 1.6;
      }
      h1 { text-wrap: balance; }
      code {
        background: #f1efea;
        padding: 0.15em 0.4em;
        border-radius: 3px;
      }
    </style>
  </head>
  <body>
    <h1>Movement Lab &mdash; deploy chain spike</h1>
    <p>
      Staging only. This page is not the Movement Lab website. It exists to
      prove that a change pushed to git becomes visible on a real URL.
    </p>
    <p>Marker: <code>{MARKER}</code></p>
    <p>Stamp: <code>{DEPLOY_STAMP}</code></p>
  </body>
</html>
