---
// Story 1-6. The services hub.
//
// PRICES COME FROM src/data/services.json, NEVER TYPED HERE (spec § 3.4).
// These numbers appear on the site, in the JSON-LD, and on a Google Business
// Profile. A second hand-typed copy is exactly how two of them end up
// disagreeing, and a wrong price is a real-world problem, not a display bug.
//
// D1 — the Movement Plan Analysis at $160 is NEW to the website and must appear
// in this summary as well as on the main service page. It is absent from the
// current site entirely.
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookCta from '../../components/BookCta.astro';
import { SERVICES } from '../../lib/cliniko.mjs';
import business from '../../data/business.json' with { type: 'json' };
import pikeDrill from '../../assets/site/2-man-pike-scaled.jpg';

const LAST_CHANGED = new Date('2026-07-31T00:00:00+10:00');

const oneToOne = SERVICES.filter((s) => s.price !== null);
const classes = SERVICES.filter((s) => s.price === null);
---

<BaseLayout
  title={`Services & Pricing | ${business.name}`}
  description="Chiropractic and movement services on Sydney's Northern Beaches. Initial consultation $120, follow-up $95, Movement Plan Analysis $160, and $20 weekly group classes in Cromer."
  updated={LAST_CHANGED}
>
  <h1>Services and pricing</h1>

  <p class="lead">
    Three one-to-one appointment types and two weekly group classes. Everything one-to-one happens at
    {' '}{business.address.venue} in {business.address.addressLocality}.
  </p>

  <h2>What are the one-to-one appointments?</h2>
  <p>
    Chiropractic consultations that combine assessment, hands-on treatment and a rehab plan, plus a
    dedicated mobility analysis if you are not in pain and want a plan built around your body. All
    three are health fund rebatable if you have chiropractic cover as an extra.
  </p>

  {/* LN-3 F7 / SM-11 (3). STACKS TO CARDS BELOW 40rem, AND THE REASON IS THE
      PRICE. As a scrolling 3-column table this hid the Price column entirely at
      375px, and Length AND Price at 320px. Lens's scroll-shadow affordance
      works and the columns were reachable, but a pricing table whose price is
      off-screen on the most common phone width is the wrong SHAPE, not a
      styling problem — the price is the single thing a visitor came to this
      section for.

      Same markup, two layouts. It stays a real <table> so the header
      association and the reading order survive for screen readers; the narrow
      layout just turns each row into a labelled block via data attributes,
      which is why the labels come from the same strings as the <th>s and cannot
      drift out of sync with them. */}
  <table class="pricing">
    <thead>
      <tr><th>Appointment</th><th>Length</th><th>Price</th></tr>
    </thead>
    <tbody>
      {
        oneToOne.map((s) => (
          <tr>
            <td data-label="Appointment">{s.label}</td>
            <td data-label="Length">{s.durationMinutes} min</td>
            <td data-label="Price">${s.price}</td>
          </tr>
        ))
      }
    </tbody>
  </table>

  <p>
    <a href="/services/chiropractic-treatment/">Full detail on what each appointment involves</a>.
  </p>

  <BookCta slug="new-patient" label="Book an initial consultation" showDetail={true} />

  <Image
    src={pikeDrill}
    alt="Two people standing on aerobic steps in a mirrored studio, folding forward to lower weighted bags towards the floor in a pike stretch"
    widths={[480, 800]}
    sizes="(max-width: 44rem) 100vw, 44rem"
    class="page-img"
  />

  <h2>What about the group classes?</h2>
  <p>
    Two weekly classes at Just Train Gym in Cromer, $20 each, one hour, and both open to complete
    beginners. They are designed as a low-commitment way to sample the same methods.
  </p>
  <ul>
    {classes.map((s) => <li>{s.label}</li>)}
  </ul>
  <p>
    <a href="/services/group-classes/">Class times and what to bring</a>, or{' '}
    <a href="/services/handstand/">handstand coaching and classes</a>.
  </p>

  <h2>Do you run workshops?</h2>
  <p>
    Yes, for businesses, gyms and studios that want a one-off event for their members. Each workshop
    is a stand-alone deep dive into a specific skill: handstands, pancake, front splits, side splits,
    back bends, or arms-overhead full flexion. Skills are modular, so longer workshops can combine
    several. Pricing is per engagement rather than fixed.
  </p>
  <p>
    Email <a href={`mailto:${business.email}`}>{business.email}</a> to talk about running one in your
    space.
  </p>

  <h2>Where to next?</h2>
  <ul class="next-links">
    <li><a href="/contact/">Book an appointment</a></li>
    <li><a href="/services/chiropractic-treatment/">Chiropractic &amp; Movement</a></li>
    <li><a href="/about/">About Keegan</a></li>
  </ul>
</BaseLayout>

<style>
  .lead {
    font-size: 1.125rem;
  }
  /* SM-11 (3). The pricing table has TWO layouts and one markup.
     The scroll container it used to live in is gone: it hid the Price column at
     375px and Length+Price at 320px, and a price you have to scroll sideways to
     find is a price most phone readers never see. */
  .pricing {
    border-collapse: collapse;
    width: 100%;
    margin: 1.5rem 0;
  }
  .pricing th,
  .pricing td {
    text-align: left;
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--ml-rule);
    vertical-align: top;
  }
  .pricing th {
    background: var(--ml-shade);
  }

  /* NARROW: one card per appointment. Each cell carries its own label from the
     data attribute, so the label text comes from the same source as the column
     header and cannot drift away from it. */
  @media (max-width: 39.999rem) {
    .pricing thead {
      /* Visually hidden, not display:none — the header cells stay in the
         accessibility tree so the table still reads as a table. */
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .pricing tr {
      display: block;
      border: 1px solid var(--ml-rule);
      border-radius: 6px;
      padding: 0.35rem 0.15rem;
      margin-bottom: 0.85rem;
    }
    .pricing td {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      border-bottom: 0;
      padding: 0.3rem 0.75rem;
    }
    .pricing td::before {
      content: attr(data-label);
      color: var(--ml-muted);
      flex: 0 0 auto;
    }
    /* The appointment name is the card's title, so it gets the row to itself
       rather than being squeezed opposite its own label. */
    .pricing td:first-child {
      display: block;
      font-weight: 600;
      padding-bottom: 0.5rem;
    }
    .pricing td:first-child::before {
      content: none;
    }
  }
  .next-links {
    padding-left: 1.1rem;
  }
  .next-links li {
    margin: 0.35rem 0;
  }
</style>
